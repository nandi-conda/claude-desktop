#!/bin/sh
# AppImage entry point for Claude Desktop. build.sh replaces @ENTRY@ with the
# path (relative to the AppDir) of the upstream launcher or Electron binary.
HERE="$(dirname "$(readlink -f "$0")")"
export APPDIR="${APPDIR:-$HERE}"

# Terminal-side update: ./Claude-Desktop-x86_64.AppImage --appimage-update
# The release's .zsync names the latest file and its SHA-1; the release server
# has no range requests, so this downloads the whole file when it changed.
if [ "${1:-}" = "--appimage-update" ]; then
  set -e
  target="${APPIMAGE:-}"
  [ -n "$target" ] || { echo "Not running from an AppImage file; nothing to update." >&2; exit 1; }
  zsync_url="@ZSYNC_URL@"
  zs="$(mktemp)"
  trap 'rm -f "$zs"' EXIT
  curl -fsSL -o "$zs" "$zsync_url"
  header="$(head -c 4096 "$zs" | tr -d '\r\000')"
  want="$(printf '%s\n' "$header" | sed -n 's/^SHA-1: *//p' | head -n1)"
  file="$(printf '%s\n' "$header" | sed -n 's/^URL: *//p' | head -n1)"
  [ -n "$want" ] && [ -n "$file" ] || { echo "Could not read $zsync_url" >&2; exit 1; }
  case "$file" in http://* | https://*) url="$file" ;; *) url="${zsync_url%/*}/$file" ;; esac
  if [ "$(sha1sum "$target" | cut -d' ' -f1)" = "$want" ]; then
    echo "Already up to date." >&2
    exit 0
  fi
  echo "Downloading $url" >&2
  curl -fL --progress-bar -o "$target.download" "$url"
  got="$(sha1sum "$target.download" | cut -d' ' -f1)"
  if [ "$got" != "$want" ]; then
    rm -f "$target.download"
    echo "Checksum mismatch (expected $want, got $got)" >&2
    exit 1
  fi
  chmod --reference="$target" "$target.download" 2>/dev/null || chmod 755 "$target.download"
  mv -f "$target.download" "$target"
  echo "Updated $target" >&2
  exit 0
fi

# chrome-sandbox can't be setuid inside an AppImage, so build.sh removes it and
# Chromium uses its user-namespace sandbox instead. Where unprivileged user
# namespaces are blocked (Ubuntu 23.10+ AppArmor default, some hardened
# kernels) that sandbox can't start either, so fall back to --no-sandbox.
no_sandbox=0
[ "${CLAUDE_APPIMAGE_NO_SANDBOX:-}" = 1 ] && no_sandbox=1
[ "$(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns 2>/dev/null)" = 1 ] && no_sandbox=1
[ "$(cat /proc/sys/kernel/unprivileged_userns_clone 2>/dev/null)" = 0 ] && no_sandbox=1
[ "$(cat /proc/sys/user/max_user_namespaces 2>/dev/null)" = 0 ] && no_sandbox=1
[ "$(id -u)" = 0 ] && no_sandbox=1
if [ "$no_sandbox" = 1 ]; then
  set -- --no-sandbox "$@"
fi

exec "$APPDIR/@ENTRY@" "$@"
